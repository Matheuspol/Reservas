{
  "name": "reservas-backend",
  "version": "1.0.0",
  "description": "API de reservas de espaços (Node, Express, TypeScript, MongoDB)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/servidor.ts",
    "build": "tsc",
    "start": "node dist/servidor.js",
    "seed": "tsx src/seed.ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{mjs,cjs,json}\" \".prettierrc.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{mjs,cjs,json}\" \".prettierrc.json\"",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "test": "jest --testPathIgnorePatterns tests/integracao",
    "test:watch": "jest --watch",
    "test:cobertura": "jest --coverage --testPathIgnorePatterns tests/integracao",
    "test:integracao": "jest tests/integracao --runInBand",
    "test:tudo": "jest --runInBand"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mongoose": "^9.9.3",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.6",
    "supertest": "^7.3.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
